<view class="container" bindtouchstart="bindTouchStart" bindtouchend="bindTouchEnd">
  <view class="content">
    <view class="title">{{currentVerse.title}}</view>
    <view class="author">{{currentVerse.author}}</view>
    <view class="poem">
      <view class="line" wx:for="{{currentVerse.content}}" wx:key="{{index}}">{{item}}</view>
    </view>
    <view class="random-btn" bindtap="randomVerse">
      <view class="btn-text">随机切换</view>
    </view>
  </view>
  <view class="back-hint" bindtap="goToPre">
    <view class="arrow">←</view>
    <view class="hint-text">pre</view>
  </view>
  <view class="swipe-hint" bindtap="goToNext">
    <view class="arrow">→</view>
    <view class="hint-text">next</view>
  </view>
</view>